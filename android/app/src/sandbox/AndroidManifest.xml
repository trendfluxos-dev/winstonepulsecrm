<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <application android:name="android.app.Application" android:label="Winstone Sandbox" tools:replace="android:name,android:label">
        <activity android:name=".MainActivity" tools:node="remove" />
        <activity android:name=".SimDialerActivity" tools:node="remove" />
        <service android:name=".telephony.WinstoneInCallService" tools:node="remove" />
        <service android:name=".telephony.CallRecordingService" tools:node="remove" />
        <receiver android:name=".telephony.CallStateReceiver" tools:node="remove" />
        <receiver android:name=".telephony.OutgoingCallReceiver" tools:node="remove" />
        <provider android:name="androidx.startup.InitializationProvider" tools:node="remove" />
        <activity android:name=".sandbox.SandboxActivity" android:exported="true" android:label="Winstone Sandbox">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>