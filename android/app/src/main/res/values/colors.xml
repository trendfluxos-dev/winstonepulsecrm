<?xml version="1.0" encoding="utf-8"?>
<!--
  Winstone Connect — সাদা কর্পোরেট প্যালেট (চারকোল লেখা, শ্যাম্পেন সোনালি অ্যাকসেন্ট), ওয়েব CRM-এর সাথে মিলিয়ে।
-->
<resources>
    <!-- Foundation -->
    <color name="win_cream">#FFFFFF</color>          <!-- app background -->
    <color name="win_cream_deep">#F5F2EA</color>     <!-- muted / surface-2 (ivory) -->
    <color name="win_white">#FFFFFF</color>          <!-- cards, sheets -->
    <color name="win_ink">#171717</color>            <!-- primary text -->
    <color name="win_ink_muted">#77736C</color>      <!-- secondary text -->
    <color name="win_border">#DED8CC</color>         <!-- hairline borders -->

    <!-- Gold accents (deepened for legibility on white) -->
    <color name="win_green">#8F6B2E</color>          <!-- accent text/icons -->
    <color name="win_green_dark">#AD8744</color>     <!-- pressed state -->
    <color name="win_green_soft">#F6EFE0</color>     <!-- tinted pill background -->
    <color name="win_live">#2E9E63</color>           <!-- on-call pulse -->

    <!-- Status -->
    <color name="win_amber">#B7791F</color>          <!-- pending / idle -->
    <color name="win_red">#C2412D</color>            <!-- failed sync / critical -->
    <color name="win_on_green">#FFFFFF</color>

    <!-- Launcher icon tile -->
    <color name="win_icon_background">#FFFFFF</color>
</resources>
